---
import Footer from "../components/Footer/Footer.astro";
import Navbar from "../components/Header/Navbar.astro";


export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title,
  description = "NexSign es una startup tecnológica en Perú que desarrolla sitios web, sistemas digitales y soluciones SEO para impulsar negocios.",
  canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString(),
  image = "https://nexsigndev.com/img/opengraph-preview.jpg",
} = Astro.props;

const pageTitle = `${title} | NexSign - Startup Tecnologica y Soluciones Digitales`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{pageTitle}</title>

    <!-- 🔐 Verificación Google Search Console -->
    <meta
      name="google-site-verification"
      content="fpFrbendmpQz0HBFD4bGy-GOYbYENIW4P1MLvCFUqms"
    />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#050714" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- OpenGraph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NexSign" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Favicon y fuentes -->
    <link rel="icon" type="image/x-icon" href="/nexsing.ico" />
    <!-- Conexión temprana a los servidores de Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Precarga del CSS (mejora la velocidad sin bloquear el render) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap"
    />

    <!-- Carga el CSS real de forma no bloqueante -->
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
      media="all"
      onload="this.media='all'"
    />

    <!-- Fallback si el usuario tiene desactivado JavaScript -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- JSON-LD para SEO local -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://nexsigndev.com/#organization",
            "name": "NexSign",
            "alternateName": ["Nexsign", "Nexsingapp"],
            "url": "https://nexsigndev.com",
            "logo": "https://nexsigndev.com/logo.svg",
            "description": "NexSign es una startup tecnologica en Peru enfocada en diseno web, desarrollo de sistemas y posicionamiento SEO para negocios.",
            "sameAs": [
              "https://www.facebook.com/nexsign",
              "https://www.linkedin.com/company/nexsign"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://nexsigndev.com/#website",
            "url": "https://nexsigndev.com",
            "name": "NexSign",
            "description": "Startup tecnologica que crea sitios web, sistemas y soluciones SEO para crecer negocios.",
            "inLanguage": "es-PE",
            "publisher": {
              "@id": "https://nexsigndev.com/#organization"
            }
          }
        ]
      }
    </script>
  </head>

  <body class="overflow-hidden overflow-y-auto bg-[#050714]">
    <Navbar />
    <slot />
    <Footer />
  </body>

  <!-- Scripts agrupados y seguros -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const switchTheme = document.querySelector("[data-switch-theme]");
      // Dark mode por defecto — se activa a menos que el usuario haya elegido explícitamente light
      if (localStorage.getItem("appTheme") === "light") {
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
      }

      if (switchTheme) {
        switchTheme.addEventListener("click", (e) => {
          e.preventDefault();
          const doc = document.documentElement;
          if (localStorage.getItem("appTheme") === "light") {
            doc.classList.add("dark");
            localStorage.setItem("appTheme", "dark");
          } else {
            doc.classList.remove("dark");
            localStorage.setItem("appTheme", "light");
          }
        });
      }

      const toggleMenu = document.querySelector("[data-toggle-nav]");
      const navbar = document.querySelector("[data-navbar]");
      const overlayNav = document.querySelector("[data-nav-overlay]");
      const iconOpen = toggleMenu?.querySelector("[data-icon-open]");
      const iconClose = toggleMenu?.querySelector("[data-icon-close]");

      if (toggleMenu && navbar && overlayNav) {
        toggleMenu.addEventListener("click", (e) => {
          e.preventDefault();
          const isOpen = toggleMenu.getAttribute("data-open-nav") === "true";
          toggleMenu.setAttribute("data-open-nav", isOpen ? "false" : "true");
          overlayNav.setAttribute("data-is-visible", isOpen ? "false" : "true");
          document.body.classList.toggle("!overflow-y-hidden", !isOpen);
          navbar.style.height = isOpen ? "0px" : `${navbar.scrollHeight}px`;
          iconOpen?.classList.toggle("opacity-0", !isOpen);
          iconOpen?.classList.toggle("pointer-events-none", !isOpen);
          iconClose?.classList.toggle("opacity-0", isOpen);
          iconClose?.classList.toggle("pointer-events-none", isOpen);
        });

        navbar.addEventListener("click", () => {
          toggleMenu.setAttribute("data-open-nav", "false");
          overlayNav.setAttribute("data-is-visible", "false");
          document.body.classList.remove("!overflow-y-hidden");
          navbar.style.height = "0px";
          iconOpen?.classList.remove("opacity-0", "pointer-events-none");
          iconClose?.classList.add("opacity-0", "pointer-events-none");
        });

        overlayNav.addEventListener("click", () => {
          toggleMenu.setAttribute("data-open-nav", "false");
          overlayNav.setAttribute("data-is-visible", "false");
          document.body.classList.remove("!overflow-y-hidden");
          navbar.style.height = "0px";
          iconOpen?.classList.remove("opacity-0", "pointer-events-none");
          iconClose?.classList.add("opacity-0", "pointer-events-none");
        });
      }
    });
  </script>
  <script
    src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    defer></script>
</html>

<style is:global>
  /* Light mode (fallback) */
  :root {
    --color-bg: 248 250 252;
    --color-border: 226 232 240;
    --color-box: 255 255 255;
    --box-border: 226 232 240;
    --box-sd: 148 163 184 / 0.2;
    --heading-1: 15 23 42;
    --heading-2: 30 41 59;
    --heading-3: 71 85 105;
  }

  /* Dark mode – diseño premium dominante */
  .dark {
    --color-bg: 5 7 20;
    --hero-bg: 5 7 20;
    --color-box: 10 13 26;
    --box-border: 255 255 255 / 0.08;
    --box-sd: 99 102 241 / 0.1;
    --heading-1: 248 250 252;
    --heading-2: 226 232 240;
    --heading-3: 148 163 184;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Raleway", sans-serif;
  }

  [data-toggle-nav][data-open-nav="true"] #line1 {
    transform: translateY(0.375rem) rotate(40deg);
  }

  [data-toggle-nav][data-open-nav="true"] #line2 {
    transform: scaleX(0);
    opacity: 0;
  }

  [data-toggle-nav][data-open-nav="true"] #line3 {
    transform: translateY(-0.375rem) rotate(-40deg);
  }

  [data-nav-overlay][data-is-visible="true"] {
    visibility: visible;
    display: flex;
  }
</style>
