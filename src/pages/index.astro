---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero/HeroSection.astro';
import QuienesSomos from '../components/Nosotros/QuienesSomos.astro';
import Servicios from '../components/Servicios/ServiciosGrid.astro';
import ProductoSection from '@/components/Producto/ProductoSection.astro';
import Proyectos from '../components/Proyectos/ProyectosGrid.astro';
import TestimoniosSection from '@/components/Testimonios/TestimoniosSection.astro';
import FaqSection from '@/components/Faq/FaqSection.astro';
