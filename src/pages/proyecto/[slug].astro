---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Header/Navbar.astro";
import { proyectos } from "../../data/proyectosData";

export async function getStaticPaths() {
  return proyectos.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const proyecto = proyectos.find((p) => p.slug === slug);

if (!proyecto) {
  throw new Error(`Proyecto no encontrado para slug: ${slug}`);
}
---

<Layout title={proyecto.titulo} description={proyecto.descripcion}>
  <Navbar />

  <div class="min-h-screen bg-[#050714]">

    <!-- Back link -->
    <div class="max-w-3xl mx-auto px-6 pt-10 pb-0">
      <a
        href="/#proyectos"
        class="inline-flex items-center gap-2 text-xs text-[#4b5563] hover:text-[#9ca3af] transition-colors duration-150"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
        </svg>
        Proyectos
      </a>
    </div>

    <!-- Contenido principal — una columna, narrativa lineal -->
    <main class="max-w-3xl mx-auto px-6 pt-12 pb-28">

      <!-- ── 1. HEADER ── -->
      <header class="mb-14">

        <!-- Categoría + región + año -->
        <div class="flex items-center gap-3 mb-5 flex-wrap">
          <span class="text-[11px] font-semibold text-[#6366f1] uppercase tracking-[0.12em]">
            {proyecto.categoria}
          </span>
          {proyecto.region && (
            <>
              <span class="w-px h-3 bg-white/[0.12]"></span>
              <span class="text-[11px] text-[#374151]">{proyecto.region}</span>
            </>
          )}
          <span class="w-px h-3 bg-white/[0.12]"></span>
          <span class="text-[11px] text-[#374151]">{proyecto.año}</span>
        </div>

        <!-- Título de negocio — primario -->
        <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-[1.06] mb-2">
          {proyecto.tituloNegocio}
        </h1>

        <!-- Nombre de marca — secundario -->
        <p class="text-sm text-[#374151] mb-5">{proyecto.titulo}</p>

        <!-- Descripción corta -->
        <p class="text-base text-[#6b7280] leading-relaxed max-w-2xl">
          {proyecto.descripcion}
        </p>

        <!-- Meta: cliente -->
        {proyecto.cliente && (
          <div class="mt-6 flex items-center gap-2">
            <span class="text-xs text-[#374151]">Cliente</span>
            <span class="w-px h-3 bg-white/[0.08]"></span>
            <span class="text-xs font-medium text-[#9ca3af]">{proyecto.cliente}</span>
          </div>
        )}
      </header>

      <!-- ── 2. IMAGEN — pequeña, integrada ── -->
      {proyecto.imagen && (
        <div class="mb-16">
          <div class="rounded-xl border border-white/[0.07] bg-[#080b18] overflow-hidden">
            <img
              src={proyecto.imagen}
              alt={proyecto.titulo}
              class="w-full max-h-64 object-contain p-8"
            />
          </div>
        </div>
      )}

      <!-- ── 3. PROBLEMA ── -->
      <section class="mb-14">
        <p class="text-[11px] font-semibold text-[#374151] uppercase tracking-[0.14em] mb-4">
          Problema
        </p>
        <p class="text-[15px] text-[#9ca3af] leading-[1.75]">
          {proyecto.problema}
        </p>
      </section>

      <!-- Divisor -->
      <div class="border-t border-white/[0.05] mb-14"></div>

      <!-- ── 4. SOLUCIÓN ── -->
      <section class="mb-14">
        <p class="text-[11px] font-semibold text-[#374151] uppercase tracking-[0.14em] mb-4">
          Solución
        </p>
        <p class="text-[15px] text-[#9ca3af] leading-[1.75]">
          {proyecto.solucion}
        </p>
      </section>

      <!-- Divisor -->
      <div class="border-t border-white/[0.05] mb-14"></div>

      <!-- ── 5. IMPACTO ── -->
      <section class="mb-14">
        <p class="text-[11px] font-semibold text-[#374151] uppercase tracking-[0.14em] mb-6">
          Impacto
        </p>
        <ul class="space-y-3">
          {proyecto.resultados.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-[6px] w-1 h-1 rounded-full bg-[#6366f1] shrink-0"></span>
              <span class="text-[15px] text-[#d1d5db] leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ── 6. STACK (opcional) ── -->
      {proyecto.stack && proyecto.stack.length > 0 && (
        <>
          <div class="border-t border-white/[0.05] mb-14"></div>
          <section class="mb-14">
            <p class="text-[11px] font-semibold text-[#374151] uppercase tracking-[0.14em] mb-4">
              Stack
            </p>
            <div class="flex flex-wrap gap-2">
              {proyecto.stack.map((tech) => (
                <span class="text-xs text-[#4b5563] px-3 py-1 rounded-md border border-white/[0.07] font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </section>
        </>
      )}

      <!-- ── CTA (si tiene enlace) ── -->
      {proyecto.enlaceWeb && (
        <div class="pt-2">
          <a
            href={proyecto.enlaceWeb}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-5 py-3 rounded-xl bg-white text-[#050714] text-sm font-semibold hover:bg-[#f0f0f0] transition-colors duration-150"
          >
            Ver proyecto
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      )}

    </main>
  </div>
</Layout>
