---
import Layout from '../layouts/Layout.astro';
import "../style/global.css";

// Sistema de controles — todos comparten la misma base visual
const base = "rounded-lg border border-white/[0.08] bg-[#080b18] text-sm focus:outline-none focus:ring-0 focus:border-indigo-600/50 focus:bg-[#0a0d1e] hover:border-white/[0.16] transition-colors duration-150";
const inputClass    = `w-full h-10 ${base} px-3.5 text-white placeholder-[#374151]`;
const textareaClass = `w-full ${base} px-3.5 py-[9px] text-white placeholder-[#374151] resize-none`;
const selectClass   = `w-full h-10 ${base} px-3.5 pr-9 text-[#6b7280] appearance-none cursor-pointer`;
const labelClass    = "block text-[11px] font-medium text-[#4b5563] uppercase tracking-[0.1em] mb-1.5";
---

<Layout
  title="Diagnóstico Digital Gratuito para tu Negocio"
  description="Analizamos tu web, sistema o presencia digital y te mostramos oportunidades reales de mejora. Solicita tu diagnóstico gratuito."
  canonical="https://nexsigndev.com/diagnostico"
>

  <!-- ─── HERO ──────────────────────────────────────────────────── -->
  <section class="relative flex flex-col justify-center min-h-[calc(100vh-4.5rem)] overflow-hidden bg-[#050714]">

    <div class="absolute top-[-80px] left-[-80px] w-[500px] h-[500px] rounded-full bg-[#0E037F] opacity-[0.10] blur-[160px] pointer-events-none"></div>
    <div class="absolute bottom-[-60px] right-[-60px] w-[400px] h-[400px] rounded-full bg-indigo-600 opacity-[0.06] blur-[140px] pointer-events-none"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto w-full px-6 lg:px-8 pt-24 pb-28 text-center">

      <p class="text-xs font-medium text-indigo-400 uppercase tracking-[0.18em] mb-6 animate-fade-in-up">
        Diagnóstico Digital · Gratuito
      </p>

      <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-black text-white leading-[1.08] tracking-tight mb-6 animate-fade-in-up delay-100">
        Solicita un diagnóstico digital<br class="hidden sm:block" />
        <span class="gradient-text-brand"> para tu negocio</span>
      </h1>

      <p class="text-gray-400 text-lg max-w-xl mx-auto mb-10 leading-relaxed animate-fade-in-up delay-200">
        Analizamos tu web, sistema o presencia digital y te mostramos oportunidades reales de mejora.
      </p>

      <div class="animate-fade-in-up delay-300">
        <a
          href="#formulario"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-white text-[#050714] font-bold text-sm hover:bg-gray-100 transition-colors duration-200 cursor-pointer"
        >
          Solicitar diagnóstico
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

    </div>

    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#050714] to-transparent pointer-events-none"></div>
  </section>


  <!-- ─── BENEFICIOS ────────────────────────────────────────────── -->
  <section class="py-20 px-6 bg-[#050714]">
    <div class="max-w-4xl mx-auto">

      <p class="text-xs font-medium text-indigo-400 uppercase tracking-[0.18em] mb-12 text-center">
        Qué incluye
      </p>

      <div class="grid sm:grid-cols-2 gap-x-16 gap-y-10">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>`,
            title: "Identificamos problemas",
            body: "Revisamos tu web o sistema y detectamos lo que frena tu crecimiento.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>`,
            title: "Oportunidades de mejora",
            body: "Encontramos puntos de alto impacto que puedes mejorar ahora mismo.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>`,
            title: "Recomendaciones claras",
            body: "Sin tecnicismos. Te decimos exactamente qué hacer y por qué.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>`,
            title: "Enfocado en resultados",
            body: "Cada observación apunta a un resultado concreto para tu negocio.",
          },
        ].map(item => (
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-9 h-9 rounded-lg border border-white/[0.08] bg-[#080b18] flex items-center justify-center mt-0.5">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <Fragment set:html={item.icon} />
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-white mb-1.5">{item.title}</p>
              <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ─── PARA QUIÉN ES ─────────────────────────────────────────── -->
  <section class="py-16 px-6 bg-[#050714]">
    <div class="max-w-2xl mx-auto">
      <div class="border border-white/[0.07] rounded-2xl bg-[#080b18] px-8 py-10">

        <p class="text-xs font-medium text-indigo-400 uppercase tracking-[0.18em] mb-5">
          Para quién es
        </p>

        <p class="text-white font-semibold text-base mb-6">
          Este diagnóstico es ideal si:
        </p>

        <ul class="space-y-3.5">
          {[
            "No tienes web todavía",
            "Tu web existe pero no genera clientes",
            "Quieres mejorar procesos con tecnología",
            "Buscas una solución digital más profesional",
          ].map(item => (
            <li class="flex items-center gap-3 text-sm text-gray-400">
              <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

      </div>
    </div>
  </section>


  <!-- ─── FORMULARIO ────────────────────────────────────────────── -->
  <section id="formulario" class="py-20 px-6 bg-[#050714] border-t border-white/[0.05]">
    <div class="max-w-2xl mx-auto">

      <p class="text-xs font-medium text-indigo-400 uppercase tracking-[0.18em] mb-4">
        Solicitar diagnóstico
      </p>
      <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight leading-tight mb-3">
        Cuéntanos tu situación
      </h2>
      <p class="text-sm text-[#4b5563] mb-10">
        Sin compromiso. Respondemos en menos de 24 horas.
      </p>

      <form action="/thanks" method="POST" class="space-y-4">

        <!-- Nombre + Negocio -->
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="nombre" class={labelClass}>Nombre</label>
            <input
              type="text" id="nombre" name="nombre" required placeholder="Tu nombre"
              class={inputClass}
            />
          </div>
          <div>
            <label for="negocio" class={labelClass}>Negocio / Empresa</label>
            <input
              type="text" id="negocio" name="negocio" placeholder="Nombre de tu negocio"
              class={inputClass}
            />
          </div>
        </div>

        <!-- Web + WhatsApp -->
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="web" class={labelClass}>Web o Instagram</label>
            <input
              type="text" id="web" name="web" placeholder="tudominio.com o @usuario"
              class={inputClass}
            />
          </div>
          <div>
            <label for="whatsapp" class={labelClass}>WhatsApp</label>
            <input
              type="tel" id="whatsapp" name="whatsapp" required placeholder="+51 999 000 000"
              class={inputClass}
            />
          </div>
        </div>

        <!-- Qué necesitas -->
        <div>
          <label for="necesidad" class={labelClass}>¿Qué necesitas?</label>
          <textarea
            id="necesidad" name="necesidad" rows="4"
            placeholder="Cuéntanos brevemente tu situación actual y qué quieres mejorar..."
            class={textareaClass}
          ></textarea>
        </div>

        <!-- Presupuesto -->
        <div>
          <label for="presupuesto" class={labelClass}>Presupuesto estimado</label>
          <div class="relative h-10">
            <select
              id="presupuesto" name="presupuesto"
              class={selectClass}
            >
              <option value="" class="bg-[#080b18] text-[#6b7280]">Seleccionar rango</option>
              <option value="less-500" class="bg-[#080b18] text-white">Menos de $500</option>
              <option value="500-1k" class="bg-[#080b18] text-white">$500 – $1,000</option>
              <option value="1k-3k" class="bg-[#080b18] text-white">$1,000 – $3,000</option>
              <option value="3k+" class="bg-[#080b18] text-white">Más de $3,000</option>
            </select>
            <svg
              class="absolute right-3 top-0 bottom-0 my-auto w-3.5 h-3.5 text-gray-500 pointer-events-none"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </div>

        <!-- Script: color del select tras selección -->
        <script>
          const sel = document.getElementById('presupuesto') as HTMLSelectElement | null;
          if (sel) {
            const update = () => { sel.style.color = sel.value ? '#fff' : ''; };
            sel.addEventListener('change', update);
          }
        </script>

        <!-- Submit -->
        <div class="pt-2">
          <button
            type="submit"
            class="w-full h-11 rounded-xl bg-white text-[#050714] text-sm font-bold hover:bg-gray-100 transition-colors duration-150 cursor-pointer"
          >
            Enviar solicitud
          </button>
          <p class="text-[11px] text-[#374151] text-center mt-3">
            Sin spam · Respuesta en menos de 24 h
          </p>
        </div>

      </form>

    </div>
  </section>


  <!-- ─── PRUEBA SOCIAL ─────────────────────────────────────────── -->
  <section class="py-16 px-6 bg-[#050714] border-t border-white/[0.04]">
    <div class="max-w-2xl mx-auto text-center">

      <p class="text-sm text-[#4b5563] mb-5">
        Trabajamos con proyectos en Perú y clientes internacionales
      </p>

      <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-[11px] text-[#374151] font-medium uppercase tracking-widest">
        <span>E-commerce</span>
        <span class="text-white/10">·</span>
        <span>Startups</span>
        <span class="text-white/10">·</span>
        <span>Consultoras</span>
        <span class="text-white/10">·</span>
        <span>Servicios locales</span>
      </div>

    </div>
  </section>


  <!-- ─── CTA FINAL ─────────────────────────────────────────────── -->
  <section class="py-20 px-6 bg-[#050714] border-t border-white/[0.05]">
    <div class="max-w-xl mx-auto text-center">

      <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight mb-4">
        ¿Listo para mejorar tu<br />presencia digital?
      </h2>

      <p class="text-sm text-[#4b5563] mb-8">
        Un diagnóstico gratuito puede cambiar el rumbo de tu negocio.
      </p>

      <a
        href="#formulario"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-white text-[#050714] font-bold text-sm hover:bg-gray-100 transition-colors duration-200 cursor-pointer"
      >
        Solicitar diagnóstico
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>

    </div>
  </section>

</Layout>
