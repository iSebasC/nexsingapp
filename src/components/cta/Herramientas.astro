---
const stack = [
  { nombre: "Figma",       logo: "/logos/figma.svg" },
  { nombre: "React",       logo: "/logos/react.svg" },
  { nombre: "Next.js",     logo: "/logos/next.svg" },
  { nombre: "Astro",       logo: "/logos/astro.svg" },
  { nombre: "Tailwind",    logo: "/logos/tailwindcss.svg" },
  { nombre: "Nest.js",     logo: "/logos/nestjs.svg" },
  { nombre: "GitHub",      logo: "/logos/github.svg" },
  { nombre: "Vercel",      logo: "/logos/vercel.svg" },
];
---

<section class="py-16 px-6 bg-[#050714] border-b border-white/[0.05]">
  <div class="max-w-7xl mx-auto">

    <!-- Label -->
    <p class="text-xs font-medium text-[#374151] uppercase tracking-[0.18em] mb-10 text-center">
      Stack tecnológico
    </p>

    <!-- Grid estático centrado -->
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      {stack.map(({ nombre, logo }) => (
        <div class="flex items-center gap-2.5 opacity-30 hover:opacity-70 transition-opacity duration-200">
          <img
            src={logo}
            alt={nombre}
            class="h-5 w-auto brightness-0 invert object-contain"
            loading="lazy"
          />
          <span class="text-xs font-medium text-gray-400 hidden sm:block">{nombre}</span>
        </div>
      ))}
    </div>

  </div>
</section>
