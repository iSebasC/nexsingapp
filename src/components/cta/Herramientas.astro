---
const herramientas = [
  { nombre: "Figma", logo: "/logos/figma.svg" },
  { nombre: "Astro", logo: "/logos/astro.svg" },
  { nombre: "Tailwind CSS", logo: "/logos/tailwindcss.svg" },
  { nombre: "React", logo: "/logos/react.svg" },
  { nombre: "Next.js", logo: "/logos/next.svg" },
  { nombre: "Nest.js", logo: "/logos/nestjs.svg" },
  { nombre: "GitHub", logo: "/logos/github.svg" },
  { nombre: "Vercel", logo: "/logos/vercel.svg" },
  { nombre: "Netlify", logo: "/logos/netlify.svg" },
];
---

<section class="py-16 bg-[#1d4ed8] dark:bg-[#0b0b0f] overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-sm font-semibold text-white uppercase tracking-wider">
      Herramientas y Tecnologías
    </h2>
    <p class="mt-2 text-3xl font-bold text-white">Con las que trabajamos</p>

    <div class="mt-10 relative overflow-hidden">
      <div
        class="flex gap-10 animate-scroll items-center w-max mx-auto"
        style="animation: scroll 30s linear infinite"
      >
        {
          herramientas.concat(herramientas).map((h, i) => (
            <div class="flex-shrink-0">
              <img
                src={h.logo}
                alt={`Logo de ${h.nombre}`}
                title={h.nombre}
                class="h-12 w-auto brightness-0 invert dark:invert-0 dark:brightness-200 grayscale hover:grayscale-0 transition duration-300"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <style>
    @keyframes scroll {
      0% {
        transform: translateX(0%);
      }
      100% {
        transform: translateX(-50%);
      }
    }
  </style>
</section>
