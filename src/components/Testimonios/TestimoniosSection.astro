---
import TestimonioCard from './TestimonioCard.astro';
import { useValoraciones } from '../../composables/useValoraciones';

const { obtenerValoraciones } = useValoraciones();
const raw = await obtenerValoraciones();
const testimonios = raw.slice(0, 2);
---

<section id="testimonios" class="py-24 px-6 bg-[#050714] border-t border-white/[0.05]">
  <div class="max-w-4xl mx-auto">

    <!-- Cabecera mínima -->
    <div class="mb-4">
      <p class="text-xs font-medium text-[#6366f1] uppercase tracking-[0.15em]">Clientes</p>
    </div>
    <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-0 leading-tight">
      Lo que dicen
    </h2>

    <!-- Testimonios -->
    <div class="mt-2">
      {testimonios.map(t => (
        <TestimonioCard
          nombre_completo={t.nombre_completo}
          area={t.area}
          comentario={t.comentario}
        />
      ))}
    </div>

  </div>
</section>
