---
const { nombre_completo, area, comentario, imagen } = Astro.props;
const initials = nombre_completo
  .split(" ")
  .map((w: string) => w[0])
  .slice(0, 2)
  .join("");
---

<figure class="grid md:grid-cols-[1fr_3fr] gap-8 md:gap-16 py-12 border-b border-white/[0.06] last:border-0 items-start">

  <!-- Persona (izquierda en desktop) -->
  <figcaption class="flex items-center gap-3 md:flex-col md:items-start md:gap-3">
    <div class="w-9 h-9 md:w-10 md:h-10 rounded-full bg-[#0E037F]/60 border border-white/[0.08] flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
      {initials}
    </div>
    <div>
      <p class="text-sm font-semibold text-white leading-tight">{nombre_completo}</p>
      <p class="text-xs text-[#4b5563] mt-0.5">{area}</p>
    </div>
  </figcaption>

  <!-- Quote (derecha en desktop) -->
  <div>
    <!-- Comilla — tipográfica, discreta -->
    <div class="text-3xl text-[#1e1b4b] font-serif leading-none mb-4 select-none" aria-hidden="true">"</div>
    <blockquote class="text-lg md:text-xl font-medium text-[#d1d5db] leading-[1.6]">
      {comentario}
    </blockquote>
  </div>

</figure>
