---
---

<main id="inicio" class="relative flex flex-col justify-center min-h-[calc(100vh-4.5rem)] overflow-hidden bg-[#050714]">

  <!-- Un solo orb — muy sutil -->
  <div class="absolute top-[-100px] left-[-60px] w-[500px] h-[500px] rounded-full bg-[#0E037F] opacity-[0.12] blur-[140px] pointer-events-none"></div>

  <!-- Grid tenue -->
  <div class="absolute inset-0 bg-grid pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 pt-20 pb-24">
    <div class="grid lg:grid-cols-2 gap-20 items-center">

      <!-- Columna izquierda -->
      <div class="max-w-xl">

        <!-- Eyebrow -->
        <p class="text-sm font-medium text-indigo-400 mb-6 tracking-wide animate-fade-in-up">
          Tecnología · Diseño · Sistemas
        </p>

        <!-- Headline -->
        <h1 class="text-5xl md:text-6xl lg:text-[4.25rem] font-black text-white leading-[1.05] tracking-tight mb-6 animate-fade-in-up delay-100">
          Impulsamos<br />negocios con<br />
          <span class="gradient-text-brand">tecnología</span>
        </h1>

        <!-- Subtítulo -->
        <p class="text-gray-400 text-lg max-w-md mb-10 leading-relaxed animate-fade-in-up delay-200">
          No solo hacemos webs. Construimos sistemas, diseñamos experiencias y
          resolvemos problemas reales.
        </p>

        <!-- CTA única + link secundario -->
        <div class="flex items-center gap-6 animate-fade-in-up delay-300">
          <a
            href="https://wa.me/51993106111?text=Hola,%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20servicios"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-white text-[#050714] font-bold text-sm hover:bg-gray-100 transition-all duration-200"
          >
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Hablar con nosotros
          </a>
          <a
            href="#proyectos"
            class="text-sm text-gray-500 hover:text-white transition-colors duration-200 flex items-center gap-1.5"
          >
            Ver proyectos
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- Columna derecha: Dashboard -->
      <div class="relative hidden lg:block animate-fade-in-up delay-300">

        <!-- Glow muy sutil -->
        <div class="absolute inset-4 bg-indigo-900/20 blur-[50px] rounded-3xl pointer-events-none"></div>

        <!-- Ventana principal -->
        <div class="relative rounded-2xl border border-white/[0.09] bg-[#080b18] overflow-hidden shadow-2xl">

          <!-- Titlebar -->
          <div class="flex items-center gap-2 px-4 py-3 border-b border-white/[0.06]">
            <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
            <div class="mx-auto text-[11px] text-gray-600 bg-white/[0.04] px-3 py-1 rounded-md border border-white/[0.05]">
              app.nexsign.io — Dashboard
            </div>
          </div>

          <!-- Cuerpo: sidebar + main -->
          <div class="flex" style="min-height: 340px;">

            <!-- Sidebar -->
            <div class="w-44 border-r border-white/[0.06] bg-white/[0.01] p-3 flex flex-col gap-0.5">
              {[
                { label: "Visión general", active: true },
                { label: "Clientes",       active: false },
                { label: "Ventas",         active: false },
                { label: "Reportes",       active: false },
              ].map(item => (
                <div class={`px-3 py-2 rounded-lg text-xs font-medium ${item.active ? "bg-indigo-500/15 text-indigo-300 border border-indigo-500/15" : "text-gray-600 hover:text-gray-400"}`}>
                  {item.label}
                </div>
              ))}
            </div>

            <!-- Main -->
            <div class="flex-1 p-5">
              <p class="text-[11px] text-gray-600 mb-4">Resumen · Última semana</p>

              <!-- Mini stats -->
              <div class="grid grid-cols-3 gap-2.5 mb-5">
                {[
                  { k: "Ingresos",  v: "S/ 48k",  d: "+18%" },
                  { k: "Clientes",  v: "374",     d: "+12%" },
                  { k: "Proyectos", v: "20",      d: "activos" },
                ].map(s => (
                  <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-3">
                    <div class="text-[10px] text-gray-600 mb-1.5">{s.k}</div>
                    <div class="text-base font-bold text-white">{s.v}</div>
                    <div class="text-[10px] text-emerald-500 mt-1">{s.d}</div>
                  </div>
                ))}
              </div>

              <!-- Chart -->
              <div class="bg-white/[0.02] border border-white/[0.05] rounded-xl p-4">
                <div class="text-[10px] text-gray-600 mb-3">Actividad mensual</div>
                <div class="flex items-end gap-1.5 h-14">
                  {[25,40,30,60,45,70,55,80,65,75,60,90].map((h, i) => (
                    <div
                      class="flex-1 rounded-sm"
                      style={`height:${h}%; background:${i === 11 ? "rgba(99,102,241,0.8)" : "rgba(99,102,241,0.15)"}`}
                    ></div>
                  ))}
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Fade inferior -->
  <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#050714] to-transparent pointer-events-none"></div>
</main>
