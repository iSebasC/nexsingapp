---
const navItems = [
  { href: "#services",    text: "Servicios" },
  { href: "#proyectos",   text: "Proyectos" },
  { href: "#testimonios", text: "Clientes" },
  { href: "#faq",         text: "FAQ" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <!-- Pill container -->
  <div class="max-w-6xl mx-auto px-4 pt-4">
    <div class="relative flex items-center justify-between h-12 px-5 rounded-2xl border border-white/[0.09] bg-[#05071a]/90 backdrop-blur-xl shadow-[0_2px_24px_rgba(0,0,0,0.5)]">

      <!-- Accent line top -->
      <div class="absolute top-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-white/[0.12] to-transparent rounded-full pointer-events-none"></div>

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <div class="w-6 h-6 rounded-md bg-[#0E037F] flex items-center justify-center">
          <img src="/nexsign_dark.png" alt="" class="w-3.5 h-3.5 object-contain brightness-0 invert" aria-hidden="true" />
        </div>
        <span class="text-sm font-semibold text-white tracking-tight">NexSign</span>
      </a>

      <!-- Nav links — desktop -->
      <nav class="hidden lg:flex items-center gap-0.5 absolute left-1/2 -translate-x-1/2" aria-label="Navegación principal">
        {navItems.map(item => (
          <a
            href={item.href}
            class="px-4 py-1.5 text-[13px] text-[#6b7280] hover:text-[#d1d5db] transition-colors duration-150 rounded-lg hover:bg-white/[0.04]"
          >
            {item.text}
          </a>
        ))}
      </nav>

      <!-- Acciones -->
      <div class="flex items-center gap-2">
        <!-- Contactar — desktop only -->
        <a
          href="#contacto"
          class="hidden lg:inline-flex items-center h-8 px-4 rounded-xl text-[13px] text-[#6b7280] hover:text-[#d1d5db] transition-colors duration-150"
        >
          Contacto
        </a>

        <!-- CTA primario -->
        <a
          href="https://wa.me/51993106111?text=Hola,%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20servicios"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center h-8 px-4 rounded-xl bg-white text-[#050714] text-[13px] font-semibold hover:bg-[#f0f0f0] transition-colors duration-150"
        >
          <span class="hidden sm:inline">Empezar proyecto</span>
          <span class="sm:hidden">Comenzar</span>
        </a>

        <!-- Hamburguesa — mobile -->
        <button
          id="nav-toggle"
          class="lg:hidden w-8 h-8 flex items-center justify-center ml-1"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <!-- Icon hamburger -->
          <svg id="icon-ham" class="w-4 h-4 text-[#9ca3af]" fill="none" viewBox="0 0 16 16">
            <path d="M2 8h12M2 4h12M2 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <!-- Icon close -->
          <svg id="icon-close" class="w-4 h-4 text-[#9ca3af] hidden" fill="none" viewBox="0 0 16 16">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu panel — debajo del pill -->
    <div
      id="mobile-nav"
      class="lg:hidden mt-2 rounded-2xl border border-white/[0.09] bg-[#05071a]/95 backdrop-blur-xl overflow-hidden"
      style="display: none;"
    >
      <nav class="flex flex-col px-3 py-3">
        {navItems.map(item => (
          <a
            href={item.href}
            class="mobile-nav-link px-4 py-3 text-sm text-[#9ca3af] hover:text-white hover:bg-white/[0.04] rounded-xl transition-colors duration-150 font-medium"
          >
            {item.text}
          </a>
        ))}
        <div class="mt-2 pt-2 border-t border-white/[0.06] px-1">
          <a
            href="#contacto"
            class="mobile-nav-link flex items-center gap-2 px-4 py-3 text-sm font-semibold text-white rounded-xl hover:bg-white/[0.04] transition-colors duration-150"
          >
            Agendar llamada
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<!-- Spacer -->
<div class="h-[72px]"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle   = document.getElementById('nav-toggle') as HTMLButtonElement;
    const mobileNav = document.getElementById('mobile-nav') as HTMLElement;
    const iconHam  = document.getElementById('icon-ham') as SVGElement;
    const iconClose = document.getElementById('icon-close') as SVGElement;
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      mobileNav.style.display = 'block';
      toggle.setAttribute('aria-expanded', 'true');
      iconHam.classList.add('hidden');
      iconClose.classList.remove('hidden');
      document.addEventListener('click', handleOutsideClick);
    }

    function closeMenu() {
      isOpen = false;
      mobileNav.style.display = 'none';
      toggle.setAttribute('aria-expanded', 'false');
      iconHam.classList.remove('hidden');
      iconClose.classList.add('hidden');
      document.removeEventListener('click', handleOutsideClick);
    }

    function handleOutsideClick(e: MouseEvent) {
      const header = document.getElementById('site-header');
      if (header && !header.contains(e.target as Node)) {
        closeMenu();
      }
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen ? closeMenu() : openMenu();
    });

    // Cerrar al hacer click en links del menú mobile
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => closeMenu());
    });

    // Scroll suave
    document.querySelectorAll('a[href^="#"]').forEach(link => {
      link.addEventListener('click', (e: Event) => {
        const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
        if (!href || href === '#') {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        const el = document.getElementById(href.slice(1));
        if (el) {
          e.preventDefault();
          const headerEl = document.getElementById('site-header') as HTMLElement;
          const offset = (headerEl?.offsetHeight ?? 72) + 12;
          window.scrollTo({ top: el.offsetTop - offset, behavior: 'smooth' });
        }
      });
    });
  });
</script>
