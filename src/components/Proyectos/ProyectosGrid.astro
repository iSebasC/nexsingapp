---
import ProyectosGridR from "./ProyectosGridR.tsx";
---

<section id="proyectos" class="py-20 px-4 md:px-8 lg:px-20 bg-gray-50 dark:bg-[#27272e] transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado Principal -->
    <div class="mb-16 text-left">
      <!-- Badge -->
      <div class="inline-block rounded-full px-4 py-1 text-sm font-medium bg-[#F6F3FE] dark:bg-[#1e293b] mb-3 transition-colors duration-300">
        <span class="text-[#020D3B] dark:text-white font-black">PRO</span>
        <span class="text-[#1864EE] font-black">YECTOS</span>
      </div>
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#020D3B] dark:text-white mb-8 leading-tight transition-colors duration-300">
        Algunos de nuestros mejores<br />
        <span class="text-[#1864EE]">trabajos.</span>
      </h2>
    </div>

    <!-- Grid de proyectos con filtros -->
    <div class="w-full">
      <ProyectosGridR client:visible />
    </div>
  </div>
</section>
