---
import ProyectosGridR from "./ProyectosGridR.tsx";
---

<section id="proyectos" class="py-24 px-6 bg-[#050714] border-t border-white/[0.05]">

  <div class="relative z-10 max-w-7xl mx-auto">

    <!-- Cabecera -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
      <div>
        <p class="text-xs font-medium text-[#6366f1] uppercase tracking-[0.15em] mb-5">Trabajo reciente</p>
        <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">Proyectos</h2>
      </div>
      <a
        href="#proyectos"
        class="text-xs font-medium text-[#4b5563] hover:text-[#9ca3af] transition-colors duration-150 flex items-center gap-1 mb-0.5"
      >
        Ver todos
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <ProyectosGridR client:visible />

  </div>
</section>
