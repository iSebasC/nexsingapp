---
---

<section id="contacto" class="py-24 px-6 bg-[#050714] border-t border-white/[0.05]">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-20 items-start">

      <!-- Izquierda -->
      <div class="lg:pt-1">
        <p class="text-xs font-medium text-[#6366f1] uppercase tracking-[0.15em] mb-5">Contacto</p>

        <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight leading-tight mb-5">
          ¿Listo para el<br />siguiente paso?
        </h2>

        <p class="text-sm text-[#4b5563] leading-relaxed mb-10 max-w-xs">
          Cuéntanos tu proyecto. Respondemos con una propuesta en menos de 24 horas.
        </p>

        <!-- Canales -->
        <div class="space-y-4 border-t border-white/[0.05] pt-8">
          <a
            href="https://wa.me/51993106111?text=Hola,%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20servicios"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 group"
          >
            <div class="w-8 h-8 rounded border border-white/[0.08] bg-white/[0.02] flex items-center justify-center shrink-0 group-hover:border-white/20 transition-colors duration-150">
              <svg class="w-4 h-4 text-[#374151] group-hover:text-[#9ca3af] transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-[#9ca3af] group-hover:text-white transition-colors duration-150">+51 993 106 111</p>
              <p class="text-[11px] text-[#374151]">WhatsApp · respuesta inmediata</p>
            </div>
          </a>

          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded border border-white/[0.08] bg-white/[0.02] flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-[#374151]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-[#9ca3af]">admdesarrolladoresg@gmail.com</p>
              <p class="text-[11px] text-[#374151]">Email · 24 horas</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario -->
      <form action="/thanks" method="POST" class="space-y-3">

        <!-- Nombre + Email -->
        <div class="grid sm:grid-cols-2 gap-3">
          <div class="space-y-1.5">
            <label for="nombre" class="block text-[11px] font-medium text-[#4b5563] uppercase tracking-[0.1em]">Nombre</label>
            <input
              type="text" id="nombre" name="nombre" required placeholder="Tu nombre"
              class="w-full h-10 rounded-lg border border-white/[0.08] bg-white/[0.03] px-3.5 text-sm text-white placeholder-[#1f2937] focus:outline-none focus:border-[#0E037F]/60 focus:bg-white/[0.05] transition-all duration-150"
            />
          </div>
          <div class="space-y-1.5">
            <label for="email" class="block text-[11px] font-medium text-[#4b5563] uppercase tracking-[0.1em]">Email</label>
            <input
              type="email" id="email" name="email" required placeholder="tu@email.com"
              class="w-full h-10 rounded-lg border border-white/[0.08] bg-white/[0.03] px-3.5 text-sm text-white placeholder-[#1f2937] focus:outline-none focus:border-[#0E037F]/60 focus:bg-white/[0.05] transition-all duration-150"
            />
          </div>
        </div>

        <!-- Servicio + Presupuesto -->
        <div class="grid sm:grid-cols-2 gap-3">
          <div class="space-y-1.5">
            <label for="servicio" class="block text-[11px] font-medium text-[#4b5563] uppercase tracking-[0.1em]">Servicio</label>
            <div class="relative">
              <select
                id="servicio" name="servicio"
                class="w-full h-10 rounded-lg border border-white/[0.08] bg-white/[0.03] px-3.5 pr-8 text-sm text-[#6b7280] focus:outline-none focus:border-[#0E037F]/60 transition-all duration-150 appearance-none"
              >
                <option value="" class="bg-[#0a0d16]">Seleccionar</option>
                <option value="web" class="bg-[#0a0d16]">Desarrollo Web</option>
                <option value="sistema" class="bg-[#0a0d16]">Sistema / CRM</option>
                <option value="diseno" class="bg-[#0a0d16]">Diseño & Branding</option>
                <option value="digital" class="bg-[#0a0d16]">Solución Digital</option>
                <option value="otro" class="bg-[#0a0d16]">Otro</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-[#374151] pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>
          <div class="space-y-1.5">
            <label for="presupuesto" class="block text-[11px] font-medium text-[#4b5563] uppercase tracking-[0.1em]">Presupuesto</label>
            <div class="relative">
              <select
                id="presupuesto" name="presupuesto"
                class="w-full h-10 rounded-lg border border-white/[0.08] bg-white/[0.03] px-3.5 pr-8 text-sm text-[#6b7280] focus:outline-none focus:border-[#0E037F]/60 transition-all duration-150 appearance-none"
              >
                <option value="" class="bg-[#0a0d16]">Rango estimado</option>
                <option value="less-500" class="bg-[#0a0d16]">Menos de $500</option>
                <option value="500-1k" class="bg-[#0a0d16]">$500 – $1,000</option>
                <option value="1k-3k" class="bg-[#0a0d16]">$1,000 – $3,000</option>
                <option value="3k+" class="bg-[#0a0d16]">Más de $3,000</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-[#374151] pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Mensaje -->
        <div class="space-y-1.5">
          <label for="mensaje" class="block text-[11px] font-medium text-[#4b5563] uppercase tracking-[0.1em]">Mensaje</label>
          <textarea
            id="mensaje" name="mensaje" rows="4"
            placeholder="Cuéntanos qué necesitas construir..."
            class="w-full rounded-lg border border-white/[0.08] bg-white/[0.03] px-3.5 py-2.5 text-sm text-white placeholder-[#1f2937] focus:outline-none focus:border-[#0E037F]/60 focus:bg-white/[0.05] transition-all duration-150 resize-none"
          ></textarea>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="w-full h-10 rounded-lg bg-white text-[#050714] text-sm font-bold hover:bg-[#f3f4f6] transition-colors duration-150"
        >
          Enviar mensaje
        </button>

        <p class="text-[11px] text-[#1f2937] text-center pt-0.5">
          Sin spam. Respuesta garantizada en 24 h.
        </p>
      </form>

    </div>
  </div>
</section>
