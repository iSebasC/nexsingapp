---
export interface Props {
  href: string;
  text: string;
  className?: string;
  variant: "primary" | "secondary";
}

const { href, text, className, variant } = Astro.props;

const styles =
  variant === "primary"
    ? "bg-gradient-to-r from-[#0E037F] to-indigo-600 text-white font-semibold hover:from-indigo-700 hover:to-violet-600 shadow-lg shadow-indigo-900/40"
    : "bg-white/5 border border-white/10 text-white hover:bg-white/10";
---

<a
  href={href}
  class={`inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-sm transition-all duration-300 hover:-translate-y-0.5 ${styles} ${className ?? ""}`}
>
  {text}
</a>
