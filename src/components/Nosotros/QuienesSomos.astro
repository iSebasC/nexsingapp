<section class="py-20 px-6 bg-[#050714] border-t border-white/[0.05]">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-[1fr_2fr] gap-12 md:gap-20 items-start">

      <!-- Izquierda: label + título -->
      <div>
        <p class="text-xs font-medium text-[#6366f1] uppercase tracking-[0.15em] mb-5">Sobre nosotros</p>
        <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight leading-tight">
          Qué es<br />NexSign
        </h2>
      </div>

      <!-- Derecha: texto -->
      <div class="flex flex-col gap-5 max-w-2xl">
        <p class="text-[#9ca3af] text-base leading-relaxed">
          NexSign es un estudio digital que diseña y desarrolla soluciones como páginas web, sistemas y plataformas personalizadas.
        </p>
        <p class="text-[#6b7280] text-base leading-relaxed">
          Ayudamos a empresas a mejorar sus procesos y crecer mediante tecnología, diseño y estrategia.
        </p>
      </div>

    </div>
  </div>
