---
import Container from "../shared/Container.astro";

const navItems = [
  { text: "Inicio",       href: "#inicio" },
  { text: "Servicios",    href: "#services" },
  { text: "Nosotros",     href: "#nosotros" },
  { text: "Proyectos",    href: "#proyectos" },
  { text: "Testimonios",  href: "#testimonios" },
  { text: "Contacto",     href: "#contacto" },
];
---

<footer class="relative bg-[#050714] border-t border-white/[0.06]">
  <Container className="py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Marca -->
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 mb-4">
          <div class="w-7 h-7 rounded-lg bg-[#0E037F] flex items-center justify-center">
            <img src="/nexsign_dark.png" alt="NexSign" class="w-4 h-4 object-contain brightness-0 invert" />
          </div>
          <span class="text-sm font-bold text-white">NexSign</span>
        </a>
        <p class="text-sm text-gray-600 leading-relaxed max-w-xs">
          Tecnología, diseño y sistemas para negocios que quieren crecer.
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <p class="text-xs font-semibold text-gray-600 uppercase tracking-[0.15em] mb-5">Navegación</p>
        <ul class="space-y-3">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-gray-600 hover:text-white transition-colors duration-150">
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <p class="text-xs font-semibold text-gray-600 uppercase tracking-[0.15em] mb-5">Contacto</p>
        <div class="space-y-3 mb-6">
          <p class="text-sm text-gray-600">contacto@nexsigndev.com</p>
          <p class="text-sm text-gray-600">+51 993 106 111</p>
        </div>
        <div class="flex gap-2.5">
          <a href="https://facebook.com/nexsign" target="_blank" rel="noopener noreferrer" aria-label="Facebook"
            class="w-8 h-8 rounded-lg border border-white/[0.07] bg-transparent flex items-center justify-center text-gray-600 hover:text-white hover:border-white/15 transition-all duration-150">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12a12 12 0 1 0-13.875 11.85v-8.385H7.078V12h3.047V9.356c0-3.007 1.792-4.669 4.533-4.669c1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.491 0-1.953.925-1.953 1.875V12h3.328l-.532 3.465h-2.796v8.385A12.002 12.002 0 0 0 24 12z"/>
            </svg>
          </a>
          <a href="https://linkedin.com/company/nexsign" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
            class="w-8 h-8 rounded-lg border border-white/[0.07] bg-transparent flex items-center justify-center text-gray-600 hover:text-white hover:border-white/15 transition-all duration-150">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.025-3.036-1.849-3.036-1.851 0-2.134 1.445-2.134 2.939v5.666H9.356V9h3.414v1.561h.049c.476-.9 1.636-1.849 3.368-1.849 3.6 0 4.266 2.368 4.266 5.452v6.288zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM3.56 20.452h3.554V9H3.56z"/>
            </svg>
          </a>
          <a href="https://wa.me/51993106111" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"
            class="w-8 h-8 rounded-lg border border-white/[0.07] bg-transparent flex items-center justify-center text-gray-600 hover:text-emerald-400 hover:border-emerald-500/20 transition-all duration-150">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom -->
    <div class="mt-16 pt-6 border-t border-white/[0.05] flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-xs text-gray-700">&copy; {new Date().getFullYear()} NexSign. Todos los derechos reservados.</p>
      <p class="text-xs text-gray-700">Perú · Disponibles para proyectos</p>
    </div>
  </Container>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('footer a[href^="#"]').forEach(link => {
        link.addEventListener('click', function(e: Event) {
          const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
          if (href) {
            const el = document.getElementById(href.substring(1));
            if (el) {
              e.preventDefault();
              const h = (document.querySelector('header') as HTMLElement)?.offsetHeight ?? 80;
              window.scrollTo({ top: el.offsetTop - h - 20, behavior: 'smooth' });
            }
          }
        });
      });
    });
  </script>
</footer>
