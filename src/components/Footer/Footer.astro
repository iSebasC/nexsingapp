---
// Imports
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";

// Mismas opciones que el navbar
const navItems = [
  { text: "Inicio", href: "#inicio" },
  { text: "Servicios", href: "#services" },
  { text: "Nosotros", href: "#nosotros" },
  { text: "Proyectos", href: "#proyectos" },
  { text: "Testimonios", href: "#testimonios" },
  { text: "Contacto", href: "#contacto" },
];
---

<footer
  class="bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 pt-20 rounded-t-3xl mt-16"
>
  <Container className="relative pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Logo y descripción -->
      <div>
        <a href="/" class="flex items-center gap-3 mb-4">
          <img
            src="/nexsign.png"
            alt="Logo NexSign"
            class="w-8 h-8 dark:hidden"
          />
          <img
            src="/nexsign_dark.png"
            alt="Logo NexSign Dark"
            class="w-8 h-8 hidden dark:block"
          />
          <span class="text-lg font-semibold text-heading-1">NexSign</span>
        </a>
        <Paragraph className="text-sm text-gray-600 dark:text-gray-400">
          Impulsamos tu presencia digital con soluciones efectivas.
        </Paragraph>

        <!-- Redes sociales -->
        <div class="flex gap-4 mt-6 text-heading-3">
          <a
            href="https://facebook.com/tuusuario"
            aria-label="Facebook"
            class="hover:text-primary transition"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              role="img"
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
            >
              <title>Facebook</title>
              <path
                d="M24 12a12 12 0 1 0-13.875 11.85v-8.385H7.078V12h3.047V9.356c0-3.007 1.792-4.669 4.533-4.669c1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.491 0-1.953.925-1.953 1.875V12h3.328l-.532 3.465h-2.796v8.385A12.002 12.002 0 0 0 24 12z"
              ></path>
            </svg>
          </a>

          <a
            href="https://linkedin.com/in/tuusuario"
            aria-label="LinkedIn"
            class="hover:text-primary transition"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              role="img"
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
            >
              <title>LinkedIn</title>
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.025-3.036-1.849-3.036-1.851 0-2.134 1.445-2.134 2.939v5.666H9.356V9h3.414v1.561h.049c.476-.9 1.636-1.849 3.368-1.849 3.6 0 4.266 2.368 4.266 5.452v6.288zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM3.56 20.452h3.554V9H3.56z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navegación simplificada -->
      <div>
        <h3 class="text-lg font-semibold text-heading-1 mb-4">Navegación</h3>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-3">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-600 dark:text-gray-400 hover:text-primary transition-colors duration-200"
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Línea inferior -->
    <div
      class="mt-10 border-t pt-6 border-gray-300 dark:border-neutral-800 text-sm text-center text-gray-500"
    >
      &copy; {new Date().getFullYear()} NexSign. Hecho con 💻 por NexSign.
    </div>
  </Container>
</footer>

<script>
  // Configurar scroll suave para los enlaces del footer
  document.addEventListener('DOMContentLoaded', function() {
    const footerLinks = document.querySelectorAll('footer a[href^="#"]');

    footerLinks.forEach(link => {
      link.addEventListener('click', function(e: Event) {
        const target = e.currentTarget as HTMLAnchorElement;
        const href = target.getAttribute('href');
        
        if (href) {
          const targetId = href.substring(1);
          const targetElement = document.getElementById(targetId);
          
          if (targetElement) {
            e.preventDefault();
            
            // Obtener la altura del header fijo
            const header = document.querySelector('header') as HTMLElement;
            const headerHeight = header ? header.offsetHeight : 80;
            
            // Calcular la posición con offset para el header fijo
            const targetPosition = targetElement.offsetTop - headerHeight - 20;
            
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }
        }
      });
    });
  });
</script>
